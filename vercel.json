{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/auth/(.*)",            "dest": "backend/api/index.py" },
    { "src": "/users/(.*)",           "dest": "backend/api/index.py" },
    { "src": "/preferences/(.*)",     "dest": "backend/api/index.py" },
    { "src": "/rooms/(.*)",           "dest": "backend/api/index.py" },
    { "src": "/matches/(.*)",         "dest": "backend/api/index.py" },
    { "src": "/recommendations/(.*)", "dest": "backend/api/index.py" },
    { "src": "/orchestrate/(.*)",     "dest": "backend/api/index.py" },
    { "src": "/health",               "dest": "backend/api/index.py" },
    {
      "src": "/(.*\\.(css|js|png|jpg|svg|ico|woff|woff2|ttf|eot))",
      "dest": "frontend/$1"
    },
    {
      "src": "/(login|register|dashboard|matches|preferences|profile|rooms|settings|ai-agents)\\.html",
      "dest": "frontend/$1.html"
    },
    { "src": "/", "dest": "frontend/index.html" }
  ],
  "env": {
    "FLASK_ENV": "production",
    "PYTHONPATH": "."
  }
}
